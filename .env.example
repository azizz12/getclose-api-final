# Copiez ce fichier en ".env" (jamais commité) et adaptez si besoin.
# Ces valeurs correspondent au docker-compose.yml fourni.

DATABASE_URL=postgresql+psycopg://getclose:getclose@localhost:5432/getclose

# Secret utilisé pour signer les tokens JWT — à changer en vrai secret,
# jamais celui-ci, avant tout déploiement réel.
JWT_SECRET_KEY=change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
